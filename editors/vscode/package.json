{
  "name": "bluepencil",
  "displayName": "bluepencil",
  "description": "Prose analysis for writers: echoes, repeats, rhythm, dialogue, readability, and more",
  "version": "0.2.0",
  "publisher": "writerslogic",
  "icon": "icon.png",
  "homepage": "https://writerslogic.github.io/bluepencil/",
  "bugs": "https://github.com/writerslogic/bluepencil/issues",
  "galleryBanner": {
    "color": "#101923",
    "theme": "dark"
  },
  "keywords": [
    "writing",
    "prose",
    "fiction",
    "novel",
    "screenplay",
    "style",
    "editing"
  ],
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/writerslogic/bluepencil.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Linters",
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:markdown",
    "onLanguage:fountain",
    "onLanguage:plaintext",
    "onStartupFinished"
  ],
  "contributes": {
    "languages": [
      {
        "id": "fountain",
        "extensions": [
          ".fountain"
        ],
        "aliases": [
          "Fountain"
        ]
      }
    ],
    "commands": [
      {
        "command": "bluepencil.checkFile",
        "title": "bluepencil: Check current file",
        "category": "bluepencil"
      },
      {
        "command": "bluepencil.runReport",
        "title": "bluepencil: Run report",
        "category": "bluepencil"
      },
      {
        "command": "bluepencil.restartLsp",
        "title": "bluepencil: Restart language server",
        "category": "bluepencil"
      }
    ],
    "configuration": {
      "title": "bluepencil",
      "properties": {
        "bluepencil.lsp.enable": {
          "type": "boolean",
          "default": false,
          "description": "Use an external bluepencil-lsp language server instead of the bundled live analysis engine."
        },
        "bluepencil.lsp.path": {
          "type": "string",
          "default": "bluepencil-lsp",
          "description": "Path to the bluepencil-lsp binary. Resolved via $PATH if not absolute."
        },
        "bluepencil.cli.path": {
          "type": "string",
          "default": "bluepencil",
          "description": "Path to the bluepencil CLI binary. Resolved via $PATH if not absolute."
        },
        "bluepencil.cli.enable": {
          "type": "boolean",
          "default": false,
          "description": "Use an installed bluepencil CLI for checks and full reports instead of the bundled engine."
        },
        "bluepencil.cli.commands": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "adverbs",
            "passive",
            "cliches",
            "filter",
            "hedges",
            "tics"
          ],
          "description": "bluepencil subcommands to run on save for inline diagnostics. Each must support --json with a findings array carrying file/line/column (the 'list' style commands: adverbs, passive, cliches, filter, hedges, tics, nominal, overused, etc.). Commands with a different JSON shape (e.g. echoes) are not supported here."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build:engine && npm run compile",
    "build:engine": "wasm-pack build ../../crates/bluepencil-web --release --target nodejs --out-dir ../../editors/vscode/engine",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "4.0.0",
    "typescript": "^5.4.0"
  }
}
